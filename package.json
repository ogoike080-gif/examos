{
  "name": "examos-2026",
  "version": "1.0.0",
  "description": "ExamOS 2026 — AI-Powered CBT Platform",
  "private": true,
  "scripts": {
    "start": "npm install --omit=dev && node server/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:desktop": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run electron:dev\"",
    "electron:dev": "cd electron && npm run dev",
    "build": "cd client && npm run build",
    "build:desktop": "cd client && npm run build && cd ../electron && npm run build",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install && cd ../electron && npm install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@google/genai": "^2.13.0",
    "adm-zip": "^0.5.16",
    "archiver": "^5.3.2",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "pdf-parse": "^1.1.1",
    "sequelize": "^6.33.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "socket.io-client": "^4.7.5",
    "zustand": "^4.5.4",
    "face-api.js": "^0.22.2",
    "react-webcam": "^7.2.0",
    "recharts": "^2.12.7",
    "react-hot-toast": "^2.4.1",
    "date-fns": "^3.6.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.427.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.41"
  }
}
