{
  "name": "examos-2026",
  "version": "1.0.0",
  "description": "ExamOS 2026 — AI-Powered CBT Platform",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "dev:desktop": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run electron:dev\"",
    "electron:dev": "cd electron && npm run dev",
    "build": "cd client && npm run build",
    "build:desktop": "cd client && npm run build && cd ../electron && npm run build",
    "install:all": "npm install && cd client && npm install && cd ../server && npm install && cd ../electron && npm install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.3",
    "@google/genai": "^2.13.0",
    "adm-zip": "^0.5.16",
    "archiver": "^5.3.2",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

