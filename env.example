# ExamOS Server Configuration
# Copy to .env and fill in your values

NODE_ENV=development
PORT=5000

# Database (MySQL / XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=examos_db

# JWT Secret (change in production!)
JWT_SECRET=examos-super-secret-key-2026-change-in-production

# Gemini API Key (for AI proctoring & question generation) — free tier at aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Paystack (for subscription payments) — get keys at dashboard.paystack.com/#/settings/developer
# Leave PAYSTACK_SECRET_KEY blank during development: payments auto-verify without hitting Paystack
# so you can test the full upgrade flow before going live. Fill both in before accepting real payments.
PAYSTACK_PUBLIC_KEY=your-paystack-public-key-here
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Admin exit token (for Electron kiosk mode exit)
ADMIN_EXIT_TOKEN=EXAMOSADMIN2026

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10mb


