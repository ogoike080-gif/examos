NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=examos_db

JWT_SECRET=replace-with-a-random-secret

GEMINI_API_KEY=your-gemini-api-key-here

# Required for real payments to work — without these, checkout is disabled
# in production (see routes/payments.js). Get these from your Paystack
# dashboard: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_live_or_test_xxx
PAYSTACK_PUBLIC_KEY=pk_live_or_test_xxx

CLIENT_URL=http://localhost:3000

ADMIN_EXIT_TOKEN=replace-with-a-random-admin-token

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10mb